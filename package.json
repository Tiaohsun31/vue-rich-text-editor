{
  "name": "@tiaohsun/vue-rich-text-editor",
  "version": "0.3.0",
  "description": "A thin, batteries-included Vue 3 wrapper around Tiptap v3 — editor component, toolbar, bubble menus, i18n, HTML/JSON output.",
  "type": "module",
  "license": "MIT",
  "author": "Tiaohsun",
  "homepage": "https://github.com/Tiaohsun31/vue-rich-text-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tiaohsun31/vue-rich-text-editor.git"
  },
  "bugs": {
    "url": "https://github.com/Tiaohsun31/vue-rich-text-editor/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "tiptap",
    "rich-text-editor",
    "wysiwyg",
    "editor",
    "prosemirror"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./extensions/image-upload": {
      "types": "./src/extensions/image-upload/index.ts",
      "default": "./src/extensions/image-upload/index.ts"
    },
    "./extensions/lightbox": {
      "types": "./src/extensions/lightbox/index.ts",
      "default": "./src/extensions/lightbox/index.ts"
    },
    "./extensions/image-lightbox": {
      "types": "./src/extensions/image-lightbox/index.ts",
      "default": "./src/extensions/image-lightbox/index.ts"
    },
    "./styles": {
      "types": "./src/styles/index.d.ts",
      "default": "./src/styles/editor.css"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-TW.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/copy-assets.mjs",
    "prepack": "pnpm build",
    "mirror": "node scripts/mirror.mjs",
    "format": "oxfmt src/",
    "lint": "oxlint ."
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./extensions/image-upload": {
        "types": "./dist/extensions/image-upload/index.d.ts",
        "default": "./dist/extensions/image-upload/index.js"
      },
      "./extensions/lightbox": {
        "types": "./dist/extensions/lightbox/index.d.ts",
        "default": "./dist/extensions/lightbox/index.js"
      },
      "./extensions/image-lightbox": {
        "types": "./dist/extensions/image-lightbox/index.d.ts",
        "default": "./dist/extensions/image-lightbox/index.js"
      },
      "./styles": {
        "types": "./dist/styles/index.d.ts",
        "default": "./dist/editor.css"
      }
    }
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@tiptap/extension-details": "^3.27.3",
    "@tiptap/extension-highlight": "^3.27.3",
    "@tiptap/extension-image": "^3.27.3",
    "@tiptap/extension-table": "^3.27.3",
    "@tiptap/extension-text-align": "^3.27.3",
    "@tiptap/extension-text-style": "^3.27.3",
    "@tiptap/extension-youtube": "^3.27.3",
    "@tiptap/extensions": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/vue-3": "^3.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tiptap/core": "^3.27.3",
    "@tiptap/pm": "^3.27.3",
    "@tiptap/vue-3": "^3.27.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "vite": "^8.1.4",
    "vue": "^3.5.39",
    "vue-tsc": "^3.3.7"
  }
}
